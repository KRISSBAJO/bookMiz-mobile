{
  "expo": {
    "name": "BookMiz",
    "slug": "bookmiz",
    "owner": "gatherplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bookmiz/logo.png",
    "scheme": "bookmizcustomeragent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.bookmiz",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bookmiz/logo.png",
        "backgroundColor": "#132849"
      },
      "package": "com.bookmiz.customeragent",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bookmiz/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#132849"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BookMiz to find services near your current city."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ca508477-5d3d-40ff-9f9c-6c0faae889bf"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ca508477-5d3d-40ff-9f9c-6c0faae889bf"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}

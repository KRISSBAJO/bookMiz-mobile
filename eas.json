{
  "cli": {
    "version": ">=18.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_IDENTITY_API_URL": "https://identity-api.bookmiz.com/api",
        "EXPO_PUBLIC_BOOKING_API_URL": "https://booking-api.bookmiz.com/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://www.bookmiz.com",
        "EXPO_PUBLIC_APP_MODE": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IDENTITY_API_URL": "https://identity-api.bookmiz.com/api",
        "EXPO_PUBLIC_BOOKING_API_URL": "https://booking-api.bookmiz.com/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://www.bookmiz.com",
        "EXPO_PUBLIC_APP_MODE": "production"
      }
    },
    "testing": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "ios": {},
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "testing": {
      "ios": {
        "ascAppId": "6780022703",
        "appleTeamId": "GXRY3YX2NL"
      }
    }
  }
}
